# Dependencies
node_modules
.pnp
.pnp.js

# Testing
coverage

# Production
dist

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local secrets that must never reach the remote — credentials belong on the
# machine that needs them, not in a repository's history, where deleting them
# later does not remove them.
.secrets.local.md
.secrets.local*

# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vite
.vite

# Temporary Word files
~$*
.vercel
.git_commit_msg.txt  
.git_commit_msg.txt 
.commitmsg.tmp
.git_commit_msg.txt
.commitmsg 
playwright/.auth/

# Playwright output
playwright-report/
test-results/
# The throwaway smoke account's password, written in plain text so a run can
# read it back. It is a credential: it must never reach the remote.
playwright/.smoke-pass.tmp
# Run logs from `npx playwright test … > x.log` — scratch, sometimes with the
# test account's e-mail in the trace.
playwright-*.log
*-verify.log
debug-*.log

# Screenshots / visual snapshots
*.png
*.jpg
*.jpeg
!public/**/*.png
!public/**/*.jpg
!src/**/*.png
!src/**/*.jpg
# Shipped assets, not screenshots: the OG fallback card the serverless
# renderer falls back to when satori fails.
!api/_lib/*.png

# Agent tooling — configuration of the tool, not of the project
.claude/
.qwen/
.mcp.json

# Standalone HTML reports (финансиски извештаи, аудити)
mismath-finansiski-izvestaj.html
mkd-slidea-finansiski-izvestaj.html

.env*.local

# Generated from the curriculum quiz bank and seeded into the database, not
# imported by the app — 1.3MB has no business in a bundle or a diff.
# Rebuild with: node scripts/buildMathTemplates.mjs <quiz-export.json>
src/lib/mathCurriculumTemplates.js
src/lib/maturaTemplates.js
